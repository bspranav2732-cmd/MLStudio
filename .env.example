# ==============================================================================
# SolvoSys — Local & HPC Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides (never commit .env to version control).

# Application Server (FastAPI Backend)
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Web Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# HPC / Supercomputer Default Connection (Configurable via UI)
HPC_HOST=dgx-login01.mahindrauniversity.edu.in
HPC_PORT=22
HPC_USERNAME=your_hpc_username
HPC_PARTITION=cpu_student
